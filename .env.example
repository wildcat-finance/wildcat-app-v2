NEXT_PUBLIC_ALCHEMY_API_KEY=<ALCHEMY_KEY>
NEXT_PUBLIC_TARGET_NETWORK=Sepolia
NEXT_PUBLIC_API_URL=<API>

NEXT_PUBLIC_TOKENS_LIST_URL=https://tokens.1inch.eth.link
NEXT_PUBLIC_TOKENS_IMG_HOSTNAME=tokens.1inch.io

NEXT_PUBLIC_GIT_WILDCAT_URL=https://github.com/wildcat-finance/wildcat-app-v2/commit

# For local wildcat-sdk package testing
# Use together with /scripts/reinstall-wildcat-sdk.sh
# WILDCAT_SDK_PATH=/Users/wildcat/wildcat/wildcat.ts/wildcatfi-wildcat-sdk-3.0.39.tgz
# Local fork harness (npm run dev:fork writes these into harness/fork/.env.fork; never set them in .env.local)
# NEXT_PUBLIC_RPC_URL_SEPOLIA=http://127.0.0.1:18545
# NEXT_PUBLIC_SUBGRAPH_URL_SEPOLIA=http://127.0.0.1:18100/subgraphs/name/wildcat-sepolia-fork-v218
# WILDCAT_SERVER_RPC_URL_SEPOLIA=http://127.0.0.1:18545
# WILDCAT_SERVER_SUBGRAPH_URL_SEPOLIA=http://127.0.0.1:18100/subgraphs/name/wildcat-sepolia-fork-v218
# NEXT_PUBLIC_TEST_MODE=1
# PORT=3001
