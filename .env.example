NEXT_PUBLIC_ALCHEMY_API_KEY=<ALCHEMY_KEY>
NEXT_PUBLIC_TARGET_NETWORK=Sepolia
NEXT_PUBLIC_API_URL=<API>

NEXT_PUBLIC_TOKENS_LIST_URL=https://tokens.1inch.eth.link
NEXT_PUBLIC_TOKENS_IMG_HOSTNAME=tokens.1inch.io

NEXT_PUBLIC_GIT_WILDCAT_URL=https://github.com/wildcat-finance/wildcat-app-v2/commit

# For local wildcat-sdk package testing
# Use together with /scripts/reinstall-wildcat-sdk.sh
# WILDCAT_SDK_PATH=/Users/wildcat/wildcat/wildcat.ts/wildcatfi-wildcat-sdk-3.0.39.tgz

# Browser sanctions screening; public, build-time config. Defaults can be omitted.
# NEXT_PUBLIC_SANCTIONS_GRAPH_URL=https://graph.wildcat.finance/mainnet-sanctions/v0.1.0
# NEXT_PUBLIC_SANCTIONS_GRAPH_DEPLOYMENT=QmV4rcuTiHaqqxxwYXNByYy17LfYuCA7TTRW7nydRTC4b6
# NEXT_PUBLIC_SANCTIONS_MAX_INDEX_AGE_SECONDS=900
# NEXT_PUBLIC_SANCTIONS_MAX_LIST_AGE_SECONDS=864000

# Local `npm run dev` only: force a result for one wallet (case-insensitive).
# Ignored in production builds and every Vercel deployment. Never NEXT_PUBLIC_.
# In local development only, this address/status fixture is passed into the page.
# SANCTIONS_DEV_ADDRESS=0x0000000000000000000000000000000000000001
# SANCTIONS_DEV_STATUS=blocked
# Supported statuses: blocked, clear, unavailable. Remove both to use live data.
