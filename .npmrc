engine-strict=true
ignore-scripts=true
save-exact=true
save-prefix=
min-release-age=7
allow-git=none
# React 19 requires tolerating unmet peer ranges for two deliberately-deferred/legacy
# dev dependencies: the Storybook 7 stack (upgrade tracked in a follow-up PR) and the
# unmaintained @safe-global/safe-apps-react-sdk. Remove once Storybook is on v10.
legacy-peer-deps=true
