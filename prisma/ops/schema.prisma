generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma-ops/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("OPS_DATABASE_URL")
  directUrl = env("OPS_DIRECT_URL")
}

model OpsAdmin {
  address   String   @id
  createdAt DateTime @default(now())
}

enum LenderKycOutcome {
  submitted
  updated
  unchanged
  skipped
}

enum LenderKycMessageKind {
  details
  ownership
}

enum LenderKycSignatureKind {
  ECDSA
  GnosisSignature
  EIP1271
}

model LenderKycNonce {
  nonce      String    @id
  chainId    Int
  address    String
  secretHash String
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([expiresAt])
}

model LenderKycSignature {
  id            String                 @id
  messageKind   LenderKycMessageKind
  outcome       LenderKycOutcome
  chainId       Int
  address       String
  signer        String
  signatureKind LenderKycSignatureKind
  blockNumber   Int?
  nonce         String                 @unique
  timeSigned    DateTime
  signature     String
  signedMessage String
  termsVersion  String
  createdAt     DateTime               @default(now())

  revisions LenderKycProfileRevision[]

  @@index([chainId, address])
}

model LenderKycProfileRevision {
  id          String   @id
  chainId     Int
  address     String
  signatureId String
  fullName    String
  email       String
  companyName String
  lenderTypes String[] @default([])
  savedAt     DateTime @default(now())

  signature LenderKycSignature @relation(fields: [signatureId], references: [id], onDelete: Restrict)

  @@index([chainId, address, savedAt])
  @@index([signatureId])
}
