generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountKind {
  EOA
  GnosisSafe
  OtherContract
}

enum SignatureKind {
  // Signature from the target account (e.g. borrower)
  ECDSA
  // Signature from the gnosis safe
  GnosisSignature
  // ECDSA signature from a single owner of the gnosis safe
  GnosisOwnerECDSA
  // Non-Gnosis EIP-1271 contract signature
  EIP1271
}

enum ServiceAgreementParty {
  Borrower
  Lender
}

enum ExportJobStatus {
  Queued    @map("queued")
  Running   @map("running")
  Completed @map("completed")
  Failed    @map("failed")
  Cancelled @map("cancelled")
}

enum ExportArtifactKind {
  Part
  Bundle
}

model ExportJob {
  id                String          @id @default(uuid())
  chainId           Int
  paramsHash        String
  params            Json
  snapshotBlock     BigInt
  snapshotBlockHash String
  snapshotTimestampUtc DateTime?
  status            ExportJobStatus @default(Queued)
  workflowRunId     String?
  progress          Int             @default(0)
  phase             String          @default("queued")
  heartbeatAt       DateTime        @default(now())
  errorClass        String?
  error             String?
  artifactKey       String?
  generatedAtUtc    DateTime?
  requestIp         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  completedAt       DateTime?
  subscriptions     ExportJobSubscription[]
  partBuilds        ExportPartBuild[]

  @@index([status, createdAt])
  @@index([requestIp, status])
  @@index([requestIp, createdAt])
  @@index([paramsHash])
}

model ExportJobSubscription {
  jobId    String
  clientId String
  cancelledAt DateTime?
  job      ExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, clientId])
}

model ExportPartBuild {
  key   String @id
  jobId String
  job   ExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ExportArtifact {
  key             String             @id
  kind            ExportArtifactKind
  jobId           String?
  checksum        String
  byteLength      Int
  pipelineVersion String
  environment     String
  createdAt       DateTime           @default(now())
  lastAccessedAt  DateTime           @default(now())

  @@index([kind, lastAccessedAt])
  @@index([jobId])
}

model ExportProviderThrottle {
  key           String   @id
  nextRequestAt DateTime
}

// @todo - need to make the borrower/lender signatures distinct as the borrower
// can technically also be a lender, but that would use a different message

model MlaSignature {
  kind        SignatureKind
  address     String
  // If the signature is from a single owner of a gnosis safe, this is the address of the
  // owner that made the signature; otherwise, it's the same as `address`
  signer      String
  signature   String
  // The block number at which the signature was verified - only relevant for non-EOA signatures
  blockNumber Int?
  // The chain ID and market address of the master loan agreement that this signature is for
  chainId     Int
  market      String

  timeSigned DateTime

  // Relation to the master loan agreement
  mla MasterLoanAgreement @relation("MlaSignatureToMasterLoanAgreement", fields: [chainId, market], references: [chainId, market])

  @@id([chainId, market, signer])
}

model RefusalToAssignMla {
  chainId     Int
  // The market address
  market      String
  // The address of the borrower
  address     String
  // The address of the signer declining the MLA
  signer      String
  // The signature of the borrower declining the MLA
  signature   String
  timeSigned  DateTime
  // The block number at which the signature was verified - only relevant for non-EOA signatures
  blockNumber Int?
  kind        SignatureKind

  acknowledgements NonMlaAcknowledgement[] @relation("RefusalToAssignMlaToNonMlaAcknowledgement")

  @@id([chainId, market])
}

model NonMlaAcknowledgement {
  chainId                    Int
  // The market address
  market                     String
  // The lender address
  address                    String
  // If the signature is from a single owner of a gnosis safe, this is the address of the
  // owner that made the signature; otherwise, it's the same as `address`
  signer                     String
  signature                  String
  kind                       SignatureKind
  // The block number at which the signature was verified - only relevant for non-EOA signatures
  blockNumber                Int?
  acknowledgementTextVersion String
  acknowledgementText        String
  timeSigned                 DateTime      @default(now())
  createdAt                  DateTime      @default(now())

  refusal RefusalToAssignMla @relation("RefusalToAssignMlaToNonMlaAcknowledgement", fields: [chainId, market], references: [chainId, market], onDelete: Cascade)

  @@id([chainId, market, address, acknowledgementTextVersion])
  @@index([chainId, address])
}

model AdminAccount {
  id      Int    @id @default(autoincrement())
  chainId Int
  address String

  @@unique([chainId, address])
}


model MlaTemplate {
  id             Int      @id @default(autoincrement())
  chainId        Int
  name           String
  description    String?
  hide           Boolean? @default(false)
  isDefault      Boolean?
  html           String
  plaintext      String
  borrowerFields Json
  lenderFields   Json

  mlas MasterLoanAgreement[] @relation("MlaTemplateToMasterLoanAgreement")

  @@unique([chainId, id])
}


model MasterLoanAgreement {
  chainId        Int
  market         String
  borrower       String
  html           String
  plaintext      String
  templateId     Int
  lenderFields   Json
  mlaSignatureId Int?

  borrowerProfile Borrower @relation("BorrowerToMasterLoanAgreement", fields: [chainId, borrower], references: [chainId, address])

  template      MlaTemplate    @relation("MlaTemplateToMasterLoanAgreement", fields: [chainId, templateId], references: [chainId, id])
  mlaSignatures MlaSignature[] @relation("MlaSignatureToMasterLoanAgreement")

  // market must be unique
  @@id([chainId, market])
}

// One immutable ToU version. Global, not chain-scoped.
model ServiceAgreement {
  id                  Int      @id @default(autoincrement())
  version             String
  plaintext           String
  html                String
  plaintextSha256     String   @unique // bare lowercase SHA-256 hex of plaintext
  legacyWrapperHash   String?  @unique // 0x-prefixed keccak256 of the signed wrapper
  acknowledgementText String   // exact wrapper body, no Date / Organization Name lines
  effectiveDate       DateTime
  isCurrent           Boolean  @default(false)
  // Re-acceptance campaign deadline for accounts that accepted an older version.
  // NULL = no campaign: a newer version exists but nothing is enforced yet.
  // Set explicitly when the campaign is announced (default now + 14 days).
  reacceptanceDeadline DateTime?
  createdAt           DateTime @default(now())

  signatures ServiceAgreementSignature[]
  refusals   ServiceAgreementRefusal[]
}

// One ToU acceptance. Chain-scoped, serves both parties.
// No FK to Borrower: borrower deletion must delete these rows explicitly.
model ServiceAgreementSignature {
  id                 Int                   @id @default(autoincrement())
  chainId            Int
  address            String
  // If the signature is from a single owner of a gnosis safe, this is the address of the
  // owner that made the signature; otherwise, it's the same as `address`
  signer             String
  party              ServiceAgreementParty
  serviceAgreementId Int
  signature          String
  // NULL for backfilled legacy rows; always set for new rows
  kind               SignatureKind?
  // The block number at which the signature was verified - only relevant for non-EOA signatures
  blockNumber        Int?
  timeSigned         DateTime
  organizationName   String?
  // Exact signed message for new rows; reconstructed (or NULL) for legacy rows
  signedMessage      String?
  createdAt          DateTime              @default(now())

  serviceAgreement ServiceAgreement @relation(fields: [serviceAgreementId], references: [id])

  @@unique([chainId, address, party, serviceAgreementId])
  @@index([serviceAgreementId])
}

// A signed refusal ("decline") of a ToU version. Kept separate from
// ServiceAgreementSignature so acceptance readers can never mistake a decline
// for an acceptance, and so a later acceptance of the same version coexists
// with the recorded decline (mirrors MlaSignature / RefusalToAssignMla).
model ServiceAgreementRefusal {
  id                 Int                   @id @default(autoincrement())
  chainId            Int
  address            String
  // If the signature is from a single owner of a gnosis safe, this is the address of the
  // owner that made the signature; otherwise, it's the same as `address`
  signer             String
  party              ServiceAgreementParty
  serviceAgreementId Int
  signature          String
  kind               SignatureKind
  // The block number at which the signature was verified - only relevant for non-EOA signatures
  blockNumber        Int?
  // Optional free-text reason the account gave when declining
  reason             String?
  timeSigned         DateTime
  createdAt          DateTime              @default(now())

  serviceAgreement ServiceAgreement @relation(fields: [serviceAgreementId], references: [id])

  @@unique([chainId, address, party, serviceAgreementId])
  @@index([serviceAgreementId])
}

model BorrowerInvitation {
  id              Int      @id @default(autoincrement())
  chainId         Int
  address         String
  name            String
  alias           String?
  inviter         String
  description     String?
  founded         String?
  headquarters    String?
  jurisdiction    String?
  physicalAddress String?
  entityKind      String?
  timeInvited     DateTime

  borrower Borrower @relation("BorrowerToInvitation", fields: [chainId, address], references: [chainId, address], onDelete: Cascade)

  @@unique([chainId, address])
}

model Borrower {
  chainId Int
  address String

  name              String?
  alias             String?
  avatar            String?
  description       String?
  founded           String?
  headquarters      String?
  website           String?
  twitter           String?
  telegram          String?
  linkedin          String?
  email             String?
  jurisdiction      String?
  physicalAddress   String?
  entityKind        String?
  additionalUrls    Json?
  registeredOnChain Boolean
  // Raw `from` of the tx that emitted BorrowerAdded; may be a Safe executor/relayer.
  // NULL = not yet resolved.
  registeredBy      String?

  invitation BorrowerInvitation?            @relation("BorrowerToInvitation")
  updates    BorrowerProfileUpdateRequest[] @relation("BorrowerToProfileUpdateRequest")
  mlas       MasterLoanAgreement[]          @relation("BorrowerToMasterLoanAgreement")

  @@unique([chainId, address])
}

model BorrowerProfileUpdateRequest {
  id        Int      @id @default(autoincrement())
  chainId   Int
  address   String
  createdAt DateTime

  name            String?
  alias           String?
  avatar          String?
  description     String?
  founded         String?
  headquarters    String?
  website         String?
  twitter         String?
  telegram        String?
  linkedin        String?
  email           String?
  jurisdiction    String?
  physicalAddress String?
  entityKind      String?
  additionalUrls  Json?

  acceptedAt     DateTime?
  rejectedAt     DateTime?
  rejectedReason String?

  borrowerProfile Borrower @relation("BorrowerToProfileUpdateRequest", fields: [chainId, address], references: [chainId, address], onDelete: Cascade)

  @@index([chainId, address])
}

model MarketDescription {
  chainId Int
  marketAddress String
  description String

  @@unique([chainId, marketAddress])
}

/// Glass Door analytics. One row per update run; exactly one row is Current.
enum GlassDoorPublicationKind {
  Intraday
  DayClose
}

enum GlassDoorPublicationStatus {
  Staged
  Current
  Superseded
  Failed
}

enum GlassDoorEntityKind {
  Market
  Borrower
}

enum GlassDoorMarketState {
  Preparing
  Ok
  UnderReview
}

enum GlassDoorScanFilter {
  MarketLogs
  TransfersOut
  TransfersIn
}

model GlassDoorPublication {
  id              String                     @id @default(uuid())
  kind            GlassDoorPublicationKind
  status          GlassDoorPublicationStatus @default(Staged)
  /// UTC day a DayClose publication records
  day             DateTime?                  @db.Date
  /// Block number, hash and timestamp per chain that the publication describes
  cuts            Json
  registryVersion String
  checks          Json?
  error           String?
  createdAt       DateTime                   @default(now())
  publishedAt     DateTime?
  snapshots       GlassDoorMetricSnapshot[]

  @@index([status, createdAt])
  @@index([kind, day])
}

/// Immutable metric values for one market or borrower in one publication.
model GlassDoorMetricSnapshot {
  id            String               @id @default(uuid())
  publicationId String
  publication   GlassDoorPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  entityKind    GlassDoorEntityKind
  chainId       Int
  entityAddress String
  day           DateTime             @db.Date
  values        Json
  flags         Json?

  @@unique([publicationId, entityKind, chainId, entityAddress])
  @@index([entityKind, chainId, entityAddress, day])
}

/// Per-market progress, latest checked dataset and end-of-history state.
model GlassDoorMarketStatus {
  chainId             Int
  address             String
  borrower            String
  deploymentBlock     BigInt
  checkedThroughBlock BigInt?
  lastEventBlock      BigInt?
  lastRebuiltBlock    BigInt?
  datasetKey          String?
  tailState           Json?
  closureCheck        Json?
  state               GlassDoorMarketState @default(Preparing)
  stateReason         String?
  updatedAt           DateTime             @updatedAt

  @@id([chainId, address])
  @@index([chainId, borrower])
}

/// A committed block range of one chain-level log scan, with the logs found.
model GlassDoorScanRange {
  id           String              @id @default(uuid())
  chainId      Int
  filter       GlassDoorScanFilter
  fromBlock    BigInt
  toBlock      BigInt
  toBlockHash  String
  /// sha256 of the sorted address set the range was scanned with
  addressSet   String
  addresses    String[]
  logCount     Int
  /// gzipped JSON array of the raw logs found in the range
  logs         Bytes
  createdAt    DateTime            @default(now())

  @@unique([chainId, filter, addressSet, fromBlock])
  @@index([chainId, filter, toBlock])
}

/// Last block of each UTC day, looked up once per chain and shared by markets.
model GlassDoorChainDay {
  chainId        Int
  day            DateTime @db.Date
  lastBlock      BigInt
  blockHash      String
  blockTimestamp Int

  @@id([chainId, day])
}
