generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SignatureKind {
  // Signature from the target account (e.g. borrower)
  ECDSA
  // Signature from the gnosis safe
  GnosisSignature
  // ECDSA signature from a single owner of the gnosis safe
  GnosisOwnerECDSA
  // Non-Gnosis EIP-1271 contract signature
  EIP1271
}

enum ServiceAgreementParty {
  Borrower
  Lender
}

enum MlaDecisionOutcome {
  Assigned
  Declined
}

enum ExportJobStatus {
  Queued    @map("queued")
  Running   @map("running")
  Completed @map("completed")
  Failed    @map("failed")
  Cancelled @map("cancelled")
}

enum ExportArtifactKind {
  Part
  Bundle
}

model ExportJob {
  id                String          @id @default(uuid())
  chainId           Int
  paramsHash        String
  params            Json
  snapshotBlock     BigInt
  snapshotBlockHash String
  snapshotTimestampUtc DateTime?
  status            ExportJobStatus @default(Queued)
  workflowRunId     String?
  progress          Int             @default(0)
  phase             String          @default("queued")
  heartbeatAt       DateTime        @default(now())
  errorClass        String?
  error             String?
  artifactKey       String?
  generatedAtUtc    DateTime?
  requestIp         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  completedAt       DateTime?
  subscriptions     ExportJobSubscription[]
  partBuilds        ExportPartBuild[]

  @@index([status, createdAt])
  @@index([requestIp, status])
  @@index([requestIp, createdAt])
  @@index([paramsHash])
}

model ExportJobSubscription {
  jobId    String
  clientId String
  cancelledAt DateTime?
  job      ExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, clientId])
}

model ExportPartBuild {
  key   String @id
  jobId String
  job   ExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ExportArtifact {
  key             String             @id
  kind            ExportArtifactKind
  jobId           String?
  checksum        String
  byteLength      Int
  pipelineVersion String
  environment     String
  createdAt       DateTime           @default(now())
  lastAccessedAt  DateTime           @default(now())

  @@index([kind, lastAccessedAt])
  @@index([jobId])
}

model ExportProviderThrottle {
  key           String   @id
  nextRequestAt DateTime
}

// One row per network the database accepts rows for. `isTestnet` is the
// network class: mainnet and testnet borrowers and MLA templates never mix.
model Network {
  chainId   Int     @id
  isTestnet Boolean

  registrations      BorrowerRegistration[]
  serviceSignatures  ServiceAgreementSignature[]
  serviceRefusals    ServiceAgreementRefusal[]
  mlaDecisions       MarketMlaDecision[]
  marketDescriptions MarketDescription[]
  adminAccounts      AdminAccount[]

  // Foreign key target that proves a network belongs to a class.
  @@unique([chainId, isTestnet])
}

model AdminAccount {
  id      Int    @id @default(autoincrement())
  chainId Int
  address String

  network Network @relation(fields: [chainId], references: [chainId])

  @@unique([chainId, address])
}

// A borrowing organisation. One row serves every network of its class; its
// addresses and on-chain approvals are BorrowerRegistration rows.
model Borrower {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isTestnet Boolean

  name            String
  alias           String?
  avatar          String?
  description     String?
  founded         String?
  headquarters    String?
  website         String?
  twitter         String?
  telegram        String?
  linkedin        String?
  email           String?
  jurisdiction    String?
  physicalAddress String?
  entityKind      String?
  additionalUrls  Json?

  registrations BorrowerRegistration[]
  updates       BorrowerProfileUpdateRequest[]
  mlaDecisions  MarketMlaDecision[]
  mlaTemplates  MlaTemplate[]

  // Foreign key target that keeps registrations and custom MLA templates in
  // the borrower's class.
  @@unique([id, isTestnet])
}

// One address of an organisation on one network: invited by an admin,
// seen on chain, or both. The Terms of Use is still signed per registration.
model BorrowerRegistration {
  chainId    Int
  address    String
  // The organisation this address acts for on this network.
  borrowerId String  @db.Uuid
  // Controlled copy: ties the network and the organisation to one class.
  isTestnet  Boolean

  // Cache of WildcatArchController.isRegisteredBorrower on this network; the
  // contract is authoritative.
  registeredOnChain Boolean   @default(false)
  // Raw `from` of the tx that emitted BorrowerAdded; may be a Safe
  // executor/relayer. NULL = not yet resolved.
  registeredBy      String?
  // When the cache was last compared with the contract; NULL = never.
  checkedAt         DateTime?

  // Set when an admin invited this address on this network; both NULL when
  // there is no open or past invitation.
  invitedBy String?
  invitedAt DateTime?

  borrower Borrower @relation(fields: [borrowerId, isTestnet], references: [id, isTestnet], onDelete: Cascade)
  network  Network  @relation(fields: [chainId, isTestnet], references: [chainId, isTestnet])

  serviceSignatures ServiceAgreementSignature[]
  serviceRefusals   ServiceAgreementRefusal[]

  @@id([chainId, address])
  // Foreign key target for borrower-party ToU rows.
  @@unique([chainId, address, borrowerId])
  @@index([borrowerId])
}

model BorrowerProfileUpdateRequest {
  id         Int      @id @default(autoincrement())
  borrowerId String   @db.Uuid
  createdAt  DateTime

  name            String?
  alias           String?
  avatar          String?
  description     String?
  founded         String?
  headquarters    String?
  website         String?
  twitter         String?
  telegram        String?
  linkedin        String?
  email           String?
  jurisdiction    String?
  physicalAddress String?
  entityKind      String?
  additionalUrls  Json?

  acceptedAt     DateTime?
  rejectedAt     DateTime?
  rejectedReason String?

  borrower Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  @@index([borrowerId, createdAt(sort: Desc)])
}

// One immutable ToU version. Global, not chain-scoped.
model ServiceAgreement {
  id                  Int      @id @default(autoincrement())
  version             String   @unique
  plaintext           String
  html                String
  plaintextSha256     String   @unique // bare lowercase SHA-256 hex of plaintext
  legacyWrapperHash   String?  @unique // 0x-prefixed keccak256 of the signed wrapper
  acknowledgementText String   // exact wrapper body, no Date / Organization Name lines
  effectiveDate       DateTime
  isCurrent           Boolean  @default(false)
  // Re-acceptance campaign deadline for accounts that accepted an older version.
  // NULL = no campaign: a newer version exists but nothing is enforced yet.
  // Set explicitly when the campaign is announced (default now + 14 days).
  reacceptanceDeadline DateTime?
  createdAt           DateTime @default(now())

  signatures ServiceAgreementSignature[]
  refusals   ServiceAgreementRefusal[]
}

// One ToU acceptance. Chain-scoped, serves both parties. A borrower row is
// tied to its registration and goes when the registration is deleted.
model ServiceAgreementSignature {
  id                 Int                   @id @default(autoincrement())
  chainId            Int
  address            String
  // If the signature is from a single owner of a gnosis safe, this is the address of the
  // owner that made the signature; otherwise, it's the same as `address`
  signer             String
  party              ServiceAgreementParty
  // Set exactly when party = Borrower: the organisation the address acted for.
  borrowerId         String?               @db.Uuid
  serviceAgreementId Int
  signature          String
  // NULL for backfilled legacy rows; always set for new rows
  kind               SignatureKind?
  // The block number at which the signature was verified - only relevant for non-EOA signatures
  blockNumber        Int?
  timeSigned         DateTime
  organizationName   String?
  // Exact signed message for new rows; reconstructed (or NULL) for legacy rows
  signedMessage      String?
  createdAt          DateTime              @default(now())

  network          Network               @relation(fields: [chainId], references: [chainId])
  // Applies to borrower rows only: PostgreSQL skips a foreign key with a NULL column.
  registration     BorrowerRegistration? @relation(fields: [chainId, address, borrowerId], references: [chainId, address, borrowerId], onDelete: Cascade, onUpdate: Cascade)
  serviceAgreement ServiceAgreement      @relation(fields: [serviceAgreementId], references: [id])

  @@unique([chainId, address, party, serviceAgreementId])
  @@index([serviceAgreementId])
}

// A signed refusal ("decline") of a ToU version. Kept separate from
// ServiceAgreementSignature so acceptance readers can never mistake a decline
// for an acceptance, and so a later acceptance of the same version coexists
// with the recorded decline.
model ServiceAgreementRefusal {
  id                 Int                   @id @default(autoincrement())
  chainId            Int
  address            String
  // If the signature is from a single owner of a gnosis safe, this is the address of the
  // owner that made the signature; otherwise, it's the same as `address`
  signer             String
  party              ServiceAgreementParty
  // Set exactly when party = Borrower: the organisation the address acted for.
  borrowerId         String?               @db.Uuid
  serviceAgreementId Int
  signature          String
  kind               SignatureKind
  // The block number at which the signature was verified - only relevant for non-EOA signatures
  blockNumber        Int?
  // Optional free-text reason the account gave when declining
  reason             String?
  timeSigned         DateTime
  createdAt          DateTime              @default(now())

  network          Network               @relation(fields: [chainId], references: [chainId])
  registration     BorrowerRegistration? @relation(fields: [chainId, address, borrowerId], references: [chainId, address, borrowerId], onDelete: Cascade, onUpdate: Cascade)
  serviceAgreement ServiceAgreement      @relation(fields: [serviceAgreementId], references: [id])

  @@unique([chainId, address, party, serviceAgreementId])
  @@index([serviceAgreementId])
}

// MLA template, shared by every network of its class. Rows are append-only:
// a signed agreement points at the template it was filled from, so a revision
// is a new row and the old one is retired.
model MlaTemplate {
  id             Int       @id @default(autoincrement())
  isTestnet      Boolean
  // Set on a custom MLA: the one borrower that may select it. NULL on a market
  // MLA, which every borrower may select.
  borrowerId     String?   @db.Uuid
  name           String
  // Tells revisions of one custom MLA apart; required when borrowerId is set.
  version        String?
  description    String?
  hide           Boolean   @default(false)
  isDefault      Boolean   @default(false)
  html           String
  plaintext      String
  borrowerFields Json
  lenderFields   Json
  // Set when Wildcat retires the template: it leaves every pick list, and the
  // markets that use it keep their signed agreement.
  retiredAt      DateTime?

  borrower  Borrower?           @relation(fields: [borrowerId, isTestnet], references: [id, isTestnet], onDelete: Restrict)
  decisions MarketMlaDecision[]

  @@index([borrowerId])
}

// The borrower's one decision about one market: an assigned agreement or a
// signed refusal.
model MarketMlaDecision {
  chainId Int
  market  String
  outcome MlaDecisionOutcome

  // The organisation that signed. Required when Assigned; NULL on a refusal
  // from an account with no borrower record.
  borrowerId      String? @db.Uuid
  // The market's on-chain borrower account that signed. A snapshot, not a key.
  borrowerAddress String

  // Equals borrowerAddress unless kind is GnosisOwnerECDSA.
  signer      String
  signature   String
  kind        SignatureKind
  // The block number at which the signature was verified - only relevant for non-EOA signatures
  blockNumber Int?
  timeSigned  DateTime

  // Present exactly when outcome = Assigned: the filled agreement the borrower
  // signed, a legal record that must not change with the template or profile.
  templateId   Int?
  html         String?
  plaintext    String?
  lenderFields Json?

  network          Network                 @relation(fields: [chainId], references: [chainId])
  borrower         Borrower?               @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  template         MlaTemplate?            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  lenderSignatures MlaLenderSignature[]
  acknowledgements NonMlaAcknowledgement[]

  @@id([chainId, market])
  // Foreign key target: lender rows can only reach a decision with their outcome.
  @@unique([chainId, market, outcome])
  @@index([borrowerId])
}

model MlaLenderSignature {
  chainId Int
  market  String
  // The lender
  address String
  // Always Assigned; exists so the foreign key can only reach an assigned agreement.
  outcome MlaDecisionOutcome @default(Assigned)

  // If the signature is from a single owner of a gnosis safe, this is the address of the
  // owner that made the signature; otherwise, it's the same as `address`
  signer      String
  signature   String
  kind        SignatureKind
  // The block number at which the signature was verified - only relevant for non-EOA signatures
  blockNumber Int?
  timeSigned  DateTime

  decision MarketMlaDecision @relation(fields: [chainId, market, outcome], references: [chainId, market, outcome], onDelete: Restrict)

  @@id([chainId, market, address])
  @@index([chainId, address])
}

model NonMlaAcknowledgement {
  chainId                    Int
  // The market address
  market                     String
  // The lender address
  address                    String
  // Always Declined; exists so the foreign key can only reach a declined market.
  outcome                    MlaDecisionOutcome @default(Declined)
  // If the signature is from a single owner of a gnosis safe, this is the address of the
  // owner that made the signature; otherwise, it's the same as `address`
  signer                     String
  signature                  String
  kind                       SignatureKind
  // The block number at which the signature was verified - only relevant for non-EOA signatures
  blockNumber                Int?
  acknowledgementTextVersion String
  acknowledgementText        String
  createdAt                  DateTime           @default(now())

  decision MarketMlaDecision @relation(fields: [chainId, market, outcome], references: [chainId, market, outcome], onDelete: Restrict)

  @@id([chainId, market, address, acknowledgementTextVersion])
  @@index([chainId, address])
}

model MarketDescription {
  chainId       Int
  marketAddress String
  description   String

  network Network @relation(fields: [chainId], references: [chainId])

  @@id([chainId, marketAddress])
}
